    <!-- About and limits -->
    <string name="about_title">About and limits</string>
    <string name="about_intro">CamSense runs 6 checks on your phone and combines them into one result. Nothing is uploaded.</string>
    <string name="about_glint">Lens check: the flashlight makes camera lenses shine as tiny bright points. The flash blinks off for a moment to tell a lens from a lamp.</string>
    <string name="about_infrared">Night-vision check: the front camera can see the infrared lights some cameras use in the dark.</string>
    <string name="about_network">Wi-Fi check: looks for devices on this Wi-Fi that stream video or answer as security cameras, and for nearby Wi-Fi networks set up by cameras.</string>
    <string name="about_ble">Bluetooth check: looks for nearby camera-like Bluetooth devices.</string>
    <string name="about_magnet">Close check: the magnetometer reacts to electronics a few centimetres away.</string>
    <string name="about_objects">Hiding-spot check: points out objects where cameras are often hidden.</string>
    <string name="about_limits_title">What no phone can catch</string>
    <string name="about_limits">Wired cameras without night vision that record to a memory card give off no Wi-Fi, Bluetooth or infrared signal. Look closely at the spots CamSense marks, and treat a Low result as no clear signs, not a guarantee.</string>
