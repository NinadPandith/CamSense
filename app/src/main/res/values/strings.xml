    <!-- Onboarding -->
    <string name="onboarding_1_title">Check any room for hidden cameras</string>
    <string name="onboarding_1_body">CamSense uses your phone\'s camera, flashlight and sensors to look for signs of a camera. Everything stays on your phone.</string>
    <string name="onboarding_2_title">Six checks, one result</string>
    <string name="onboarding_2_body">A guided scan walks you through each check in about 5 minutes, then shows Low, Medium or High risk with the reasons.</string>
    <string name="onboarding_3_title">What a phone can and can\'t find</string>
    <string name="onboarding_3_body">Wired cameras that record to a card can show no signal at all. A Low result means no clear signs were found, not that the room is camera-free.</string>

